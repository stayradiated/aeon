{
  "name": "aeon",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "just dev",
    "build": "just build",
    "test": "just test",
    "tidy": "just fix"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.118",
    "@chenglou/pretext": "1.0.0",
    "@date-fns/tz": "1.5.0",
    "@date-fns/utc": "2.1.1",
    "@emoji-mart/data": "1.2.1",
    "@floating-ui/dom": "1.8.0",
    "@node-rs/argon2": "2.2.2",
    "@oslojs/crypto": "1.0.1",
    "@oslojs/encoding": "1.1.0",
    "@slack/web-api": "8.4.0",
    "@stayradiated/hydro": "1.1.0",
    "@sveltelaunch/svelte-5-email": "0.0.11",
    "ai": "7.0.173",
    "async-mutex": "0.5.0",
    "cookie": "2.0.2",
    "date-fns": "4.4.0",
    "emoji-mart": "5.6.0",
    "graphile-migrate": "1.4.1",
    "p-map": "7.1.1",
    "pg": "8.23.1",
    "pg-boss": "12.38.2",
    "quick-lru": "8.0.0",
    "replicache": "15.3.0",
    "resend": "6.38.1",
    "signia": "0.1.5",
    "svelte-awesome-color-picker": "4.1.3",
    "websocket-ts": "3.0.0",
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@roughapp/replimock": "15.3.0",
    "@stayradiated/error-boundary": "4.3.0",
    "@sveltejs/adapter-node": "6.0.2",
    "@sveltejs/kit": "3.2.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.15.0",
    "eslint-plugin-svelte": "3.24.1",
    "id128": "1.6.6",
    "kanel": "4.0.6",
    "kanel-kysely": "4.0.1",
    "kanel-zod": "4.0.3",
    "knip": "6.45.1",
    "kysely": "0.29.9",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "test-fixture-factory": "3.0.0",
    "type-fest": "6.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "knip": {
    "vite": false,
    "vitest": false,
    "svelte": {
      "entry": [
        "./src/env.ts",
        "./src/routes/**/+{layout,page,server,error}{,.server}.{svelte,ts}",
        "./src/hooks.client.ts",
        "./src/hooks.server.ts",
        "./src/**/*.test.ts",
        "vite.config*.ts"
      ],
      "project": [
        "./src/**/*.ts"
      ]
    },
    "ignore": [
      "kanel.config.cjs",
      "__legacy/**",
      "gmrc.cjs",
      "prod-server.js",
      "scripts/db/snapshot-schema.ts",
      "src/lib/server/db/log-query.ts"
    ],
    "ignoreIssues": {
      "tsconfig.json": [
        "unlisted"
      ]
    },
    "ignoreDependencies": [
      "@biomejs/biome",
      "graphile-migrate",
      "kanel",
      "kanel-kysely",
      "kanel-zod",
      "svelte-check"
    ],
    "ignoreBinaries": [
      "just"
    ],
    "ignoreExportsUsedInFile": {
      "type": true
    },
    "tags": [
      "-knipignore"
    ]
  },
  "pnpm": {
    "overrides": {
      "@kristiandupont/recase": "1.4.1"
    },
    "patchedDependencies": {
      "replicache": "patches/replicache.patch"
    }
  }
}
